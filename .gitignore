.venv/
__pycache__/
*.pyc
.DS_Store

# diagnostic / probe runs (leading underscore)
output/_*/
output/_*.log

# per-run intermediates: rebuilt from data/ on the next run
output/*/data.db
output/*/split.npz
output/*/nbl_cache/
output/*/lightning/*.ckpt
output/*/lightning/hparams.yaml

# local tool state / schnetpack lock files
.claude/
*.lock

# redistribution not checked (MACE-OFF23 test split, SPICE-derived): keep local
data/ood/off23_test_sample300.xyz
output/*/lightning/*/hparams.yaml
output/*/ood_pool.npz
